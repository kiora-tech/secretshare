{% extends 'base.html.twig' %}

{% block title %}Your secret inbox · secretshare{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}
{% block canonical %}{% endblock %}
{% block importmap %}{{ importmap(['app', 'pages/inbox'], {nonce: csp_nonce()}) }}{% endblock %}

{% block body %}
<section class="page">
    <div class="wrap narrow">
        <div class="panel">
            <div id="inbox-loading"><p class="aside">Opening your inbox…</p></div>

            <div id="inbox-pending" hidden>
                <h1>No answer yet.</h1>
                <p>Your request is open until <strong id="inbox-expires"></strong>. Come back to this link later: it is the only way to open the answer.</p>
                <p class="note note--error" id="inbox-error" role="alert" hidden></p>
                <div class="field">
                    <button class="btn btn--block" type="button" id="inbox-refresh">Check again</button>
                </div>
                <button class="btn btn--block btn--danger btn--hold" type="button" id="inbox-cancel">
                    <span class="btn__fill" aria-hidden="true"></span>
                    <span class="btn__label">Press and hold to cancel this request</span>
                </button>
                <p class="hint" id="inbox-cancel-hint">Hold for one second. Cancelling erases the request: the link you sent stops working.</p>
            </div>

            <div id="inbox-ready" hidden>
                <h1>Your answer is here.</h1>
                <p>It can be opened once. Then it is erased from our servers: copy what you need right away.</p>
                <p class="note note--error" id="inbox-ready-error" role="alert" hidden></p>
                {# Maintenir, pas cliquer : les scanners de messagerie qui cliquent sur les boutons ne maintiennent pas. #}
                <button class="btn btn--block btn--hold" type="button" id="inbox-submit">
                    <span class="btn__fill" aria-hidden="true"></span>
                    <span class="btn__label">Press and hold to open</span>
                </button>
                <p class="hint" id="inbox-hint">Hold for one second. Email scanners click buttons but don't hold them, so they can't use up your answer.</p>
            </div>

            <div id="inbox-open" hidden>
                <h1>Their answer.</h1>
                <div class="burnt">
                    {% include 'partials/flame.html.twig' with {variant: 'bare', size: 34} %}
                    <p class="status status--done">Deleted from our servers</p>
                </div>
                <div class="secret-box" id="inbox-box">
                    <div class="secret" id="inbox-text"></div>
                </div>
                <div class="copy-row" id="inbox-copy-row">
                    <input id="inbox-copy-source" type="text" readonly tabindex="-1" aria-hidden="true" class="sr-only">
                    <button class="btn btn--secondary btn--small" type="button" data-copy="inbox-copy-source">Copy the secret</button>
                </div>
                <ul class="files" id="inbox-files" hidden></ul>
                <p class="note note--warn">The answer has been deleted from our servers. Copy it before you leave this page: it cannot be shown again.</p>
            </div>

            <div id="inbox-gone" hidden>
                <h1>This inbox is empty.</h1>
                <p>The answer was already opened, the request expired or was cancelled, or this link is incomplete (the part after the <strong>#</strong> must be intact).</p>
                <a class="btn btn--secondary" href="{{ path('request_new') }}">Create a new request</a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
